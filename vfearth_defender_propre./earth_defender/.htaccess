# ============================================================
# Earth Defender - configuration Apache / LiteSpeed (o2switch)
# À placer à la racine du site, à côté de index.html.
# ============================================================

# Pas de listing des dossiers si on tape /public/ dans l'URL
Options -Indexes

# --- Types de fichiers (un module JS doit être servi en JavaScript) ---
<IfModule mod_mime.c>
    AddType text/javascript .js
    AddType audio/mpeg .mp3
</IfModule>

# --- Redirection HTTP -> HTTPS ---
# ATTENTION : active d'abord le certificat SSL (AutoSSL) dans cPanel, sinon le site devient inaccessible.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Jamais de dossiers/fichiers cachés (.git, .env...) sauf .well-known (certificats)
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    # Ni le code source, ni les dépendances de développement
    RewriteRule ^(src|node_modules)(/|$) - [F,L]
</IfModule>

# Fichiers de développement qui n'ont rien à faire en ligne
<FilesMatch "(\.(ts|map|md|lock)|^package(-lock)?\.json|^tsconfig\.json|^Dockerfile|^\.dockerignore|^\.gitignore)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# --- En-têtes de sécurité ---
<IfModule mod_headers.c>
    # Le jeu n'a besoin que de ses propres fichiers : tout le reste est interdit.
    Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; media-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    # HTTPS obligatoire pendant 6 mois (à garder seulement une fois le HTTPS vérifié)
    Header always set Strict-Transport-Security "max-age=15552000"
</IfModule>

# --- Performance : compression et cache ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType audio/mpeg "access plus 1 month"
    ExpiresByType text/css "access plus 1 day"
    # Le JS compilé et la page changent quand tu mets à jour le jeu : cache court
    ExpiresByType text/javascript "access plus 1 hour"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
