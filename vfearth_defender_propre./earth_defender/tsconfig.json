{
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./build",
        "target": "ES2020",
        "module": "ES2020",
        "moduleResolution": "Bundler",
        "lib": ["ES2020", "DOM"],
        "strict": true,
        "noUnusedLocals": true,
        "noImplicitReturns": true,
        "sourceMap": false
    },
    "include": ["src"]
}
